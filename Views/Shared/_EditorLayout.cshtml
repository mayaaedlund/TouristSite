@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="sv">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] - Småstads Turistbyrå</title>

    <link rel="stylesheet" href="~/css/normalize.css">
    <link rel="stylesheet" href="~/css/style.css">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>

<body>

    <header class="editor">
        <div class="header-hero-container">
            <img src="~/images/sommarvag-600x347.png"
                 alt="Småstads landsväg"
                 class="header-hero">
        </div>

        <div class="header-content">
            <h1 class="header-title">Småstad</h1>
            <p class="header-subtitle">
                Kommunen där vi bryr oss om varandra
            </p>
        </div>
    </header>

    <nav>
        <div class="container nav-container">

            <a asp-controller="Home"
               asp-action="Index"
               class="logo">
                Småstad Turistbyrå
            </a>

            <ul>
                <li>
                    <a asp-controller="Editor"
                       asp-action="StartEditor"
                       class="@(controller == "Editor" && action == "StartEditor" ? "active" : "")">
                        Start
                    </a>
                </li>

                <li>
                    <a asp-controller="Editor"
                       asp-action="BookEvent"
                       class="@(controller == "Editor" && action == "BookEvent" ? "active" : "")">
                        Lägg till evenemang
                    </a>
                </li>

                <li>
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="login">
                        Logga ut
                    </a>
                </li>
            </ul>

        </div>
    </nav>

    @RenderBody()

    <footer>
        <div class="container">
            <div class="footer-content">

                <div class="footer-section">
                    <h3 class="footer-title">Kontakt</h3>
                    <p>Lilla Torget 2, Småstad</p>
                    <p>0123-457 84 54</p>
                    <p>info@smastad.com</p>
                </div>

                <div class="footer-section">
                    <h3 class="footer-title">Länkar</h3>

                    <ul>
                        <li>
                            <a asp-controller="Home"
                               asp-action="Index">
                                Hem
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Citizen"
                               asp-action="About">
                                Om oss
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Citizen"
                               asp-action="Contact">
                                Kontakt
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Citizen"
                               asp-action="EventList">
                                Evenemang
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Account"
                               asp-action="Login">
                                Logga in
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3 class="footer-title">Sociala medier</h3>

                    <p>
                        <a href="#" class="fa fa-facebook"></a>
                        <a href="#" class="fa fa-instagram"></a>
                        <a href="#" class="fa fa-twitter"></a>
                    </p>
                </div>

            </div>

            <div class="footer-bottom">
                <p>Småstad Turistbyrå</p>
            </div>

        </div>
    </footer>

</body>
</html>